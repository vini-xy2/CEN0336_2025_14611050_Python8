import sys
#Aqui pedi-se o nome do arquivo com input() e o strip() para remover 
#espaços nas pontas. 
nome_arquivo = input("Digite o nome do arquivo multi-Fasta: ").strip() 

#Em seguida é criado um dicionario para guardar a contagem dos 
#nucleotídeos e uma váriavel para monitorizar qual sequencia esta sendo
#avaliada.
seqs = {}
nome_atual = None  
 
# Abre o arquivo para leitura e se o arquivo não existir, o try/except
# fecha o programa e imprime a mensagem de erro.

try:
    arquivo = open(nome_arquivo)
except FileNotFoundError:
    print(f"Erro: o arquivo '{nome_arquivo}' não foi encontrado.")
    sys.exit(1)
 
#O uso do with para ler o arquivo linha por linha e contar os nucleotídeos

with arquivo:
    for linha in arquivo:
        linha = linha.strip()
 
# If para ignorar linhas vazias.
        if linha == "":
            continue

# If para pegar só a primeira palavra depois do ">"do cabeçalho.
        if linha.startswith(">"):
           
            nome_atual = linha[1:].split()[0]
            seqs[nome_atual] = {"A": 0, "T": 0, "G": 0, "C": 0}
        else:
            
# Para linha de sequência sem cabeçalho antes imprimir erro.
            if nome_atual is None:
                print("Erro: o arquivo não está no formato FASTA (falta a linha com '>').")
                sys.exit(1)
 
# Percorre cada letra da linha e soma 1 no contador.
            for nucleotideo in linha.upper():
                if nucleotideo in seqs[nome_atual]:
                    seqs[nome_atual][nucleotideo] += 1
 
#Impressão do resultado.
for nome, contagem in seqs.items():
    print(f"{nome}\t{contagem['A']}\t{contagem['T']}\t{contagem['G']}\t{contagem['C']}")
